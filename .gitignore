```gitignore
# Dependencies
node_modules/

# Build outputs
.next/
dist/
build/

# Environment variables
.env
.env.local
*.env.*

# Logs
*.log

# Coverage reports
coverage/
.nyc_output/
.jest_coverage/

# IDE files
.vscode/
.idea/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Python cache (if applicable)
__pycache__/
*.pyc
*.pyo
*.pyd

# TypeScript/JavaScript
*.tsbuildinfo
.nuxt/
public/build/

# Temporary files
*.tmp
*.temp
.DS_Store
```